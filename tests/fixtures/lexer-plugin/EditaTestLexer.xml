<?xml version="1.0" encoding="UTF-8" ?>
<!-- La configuración del plugin de lexer de las pruebas, como plugins\Config\<plugin>.xml de N++ -->
<NotepadPlus>
    <Languages>
        <Language name="Fichas" ext="fic" commentLine="#">
            <Keywords name="instre1">mover girar</Keywords>
        </Language>
    </Languages>
    <LexerStyles>
        <LexerType name="Fichas" desc="Fichas" ext="ficha">
            <WordsStyle name="DEFAULT" styleID="0" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="COMMENT" styleID="1" fgColor="008000" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" />
            <WordsStyle name="INSTRUCTION" styleID="2" fgColor="0000FF" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" keywordClass="instre1">saltar</WordsStyle>
            <WordsStyle name="NUMBER" styleID="3" fgColor="FF8000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" />
        </LexerType>
    </LexerStyles>
</NotepadPlus>
