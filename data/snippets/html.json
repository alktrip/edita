{
  "html5": {
    "prefix": "!",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"${1:es}\">",
      "<head>",
      "\t<meta charset=\"UTF-8\">",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "\t<title>${2:Documento}</title>",
      "</head>",
      "<body>",
      "\t$0",
      "</body>",
      "</html>"
    ],
    "description": "Documento HTML5"
  },
  "div": {
    "prefix": "div",
    "body": "<div${1: class=\"$2\"}>$0</div>",
    "description": "<div>"
  },
  "a": {
    "prefix": "a",
    "body": "<a href=\"${1:#}\">$0</a>",
    "description": "Enlace"
  },
  "img": {
    "prefix": "img",
    "body": "<img src=\"${1}\" alt=\"${2}\">",
    "description": "Imagen"
  },
  "script": {
    "prefix": "script",
    "body": "<script src=\"${1}\"></script>",
    "description": "<script>"
  },
  "link css": {
    "prefix": "link",
    "body": "<link rel=\"stylesheet\" href=\"${1:estilo.css}\">",
    "description": "Hoja de estilos"
  },
  "ul": {
    "prefix": "ul",
    "body": [
      "<ul>",
      "\t<li>$0</li>",
      "</ul>"
    ],
    "description": "Lista"
  }
}
