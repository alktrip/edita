    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <releases>
    <release version="1.0.0" date="2026-11-28" type="stable">
      <url type="details">https://github.com/alktrip/edita/releases/tag/v1.0.0</url>
      <description>
        <p>The first stable release. Since 1.0.0-rc.7: word wrap per document, the Bash Function List with quoted here-documents, an icon for monitored documents, and AppStream metadata for the Linux software stores.</p>
        <p xml:lang="es">La primera versión estable. Desde la 1.0.0-rc.7: ajuste de línea por documento, la lista de funciones de Bash con here-documents entre comillas, un icono para los documentos en seguimiento y los metadatos de AppStream para las tiendas de Linux.</p>
      </description>
    </release>
    <release version="1.0.0~rc.7" date="2026-11-24" type="development">
      <url type="details">https://github.com/alktrip/edita/releases/tag/v1.0.0-rc.7</url>
      <description>
        <p>Catches up with the latest Notepad++ changes: trimming spaces keeps your place, sorting tabs respects pinned tabs, a color for C++ user-defined literals, and new styles reach existing users.</p>
        <p xml:lang="es">Al día con los últimos cambios de Notepad++: recortar espacios sin perder el sitio, ordenar las pestañas respetando las fijadas, un color para los literales de usuario de C++, y los estilos nuevos llegan a quien ya usaba Edita.</p>
      </description>
    </release>
    <release version="1.0.0~rc.6" date="2026-11-18" type="development">
      <url type="details">https://github.com/alktrip/edita/releases/tag/v1.0.0-rc.6</url>
    </release>
    <release version="1.0.0~rc.4" date="2026-11-14" type="development">
      <url type="details">https://github.com/alktrip/edita/releases/tag/v1.0.0-rc.4</url>
    </release>
    <release version="1.0.0~rc.1" date="2026-11-12" type="development">
      <url type="details">https://github.com/alktrip/edita/releases/tag/v1.0.0-rc.1</url>
    </release>
    <release version="0.9.0~beta.1" date="2026-11-04" type="development">
      <url type="details">https://github.com/alktrip/edita/releases/tag/v0.9.0-beta.1</url>
    </release>
  </releases>
</component>
