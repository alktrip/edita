<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado por CMake a partir de resources/edita.metainfo.xml.in (fase 104). AppStream: lo
     que muestran GNOME Software, KDE Discover y Flathub. Al publicar una versión, añadirla en
     <releases> (tst_metainfo lo comprueba) -->
<component type="desktop-application">
  <id>@EDITA_METAINFO_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Edita</name>
  <summary>Text and code editor with the Notepad++ workflow</summary>
  <summary xml:lang="es">Editor de texto y código con el flujo de trabajo de Notepad++</summary>

  <developer id="io.github.alktrip">
    <name>Edita contributors</name>
    <name xml:lang="es">Colaboradores de Edita</name>
  </developer>

  <description>
    <p>
      Edita is a native Linux editor for people who know Notepad++: the same menus, shortcuts,
      search modes, macros, sessions, themes and configuration files, on the same editing engine
      (Scintilla and Lexilla). It runs Notepad++ plugins too, through a compatible plugin API.
    </p>
    <p xml:lang="es">
      Edita es un editor nativo para Linux para quien conoce Notepad++: los mismos menús, atajos,
      modos de búsqueda, macros, sesiones, temas y archivos de configuración, sobre el mismo motor
      de edición (Scintilla y Lexilla). También ejecuta plugins de Notepad++, con una API de
      plugins compatible.
    </p>
    <p>On top of that, it has what a developer expects from a modern editor:</p>
    <p xml:lang="es">Además, tiene lo que se espera de un editor moderno:</p>
    <ul>
      <li>Language servers (LSP): diagnostics, completion, go to definition, rename and formatting</li>
      <li xml:lang="es">Servidores de lenguaje (LSP): diagnósticos, autocompletado, ir a la definición, renombrar y formatear</li>
      <li>Git: changes in the margin, staging of single blocks, a commit panel and the history of a file</li>
      <li xml:lang="es">Git: los cambios en el margen, preparar un solo bloque, un panel de commit y el historial de un archivo</li>
      <li>An integrated terminal, project tasks with clickable errors and file comparison</li>
      <li xml:lang="es">Una terminal integrada, tareas del proyecto con los errores enlazados y comparar archivos</li>
      <li>A command palette, CSV, JSON and YAML tools, a TODO panel and a secret scanner</li>
      <li xml:lang="es">Una paleta de órdenes, herramientas de CSV, JSON y YAML, un panel TODO y un detector de secretos</li>
      <li>95 languages, 30 themes, a catalog of signed plugins and a built-in manual</li>
      <li xml:lang="es">95 lenguajes, 30 temas, un catálogo de plugins firmados y un manual incluido</li>
    </ul>
    <p>The interface is available in English and Spanish.</p>
    <p xml:lang="es">La interfaz está en inglés y en español.</p>
  </description>

  <launchable type="desktop-id">@EDITA_DESKTOP_ID@.desktop</launchable>
  <provides>
    <binary>@EDITA_APP_ID@</binary>
  </provides>

  <url type="homepage">https://alktrip.github.io/edita/</url>
  <url type="bugtracker">https://github.com/alktrip/edita/issues</url>
  <url type="vcs-browser">https://github.com/alktrip/edita</url>
  <url type="contribute">https://github.com/alktrip/edita/blob/main/CONTRIBUTING.md</url>

  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
    <category>Development</category>
  </categories>
  <keywords>
    <keyword>text</keyword>
    <keyword>editor</keyword>
    <keyword>code</keyword>
    <keyword>notepad</keyword>
    <keyword>Notepad++</keyword>
    <keyword>programming</keyword>
    <keyword xml:lang="es">texto</keyword>
    <keyword xml:lang="es">editor</keyword>
    <keyword xml:lang="es">código</keyword>
    <keyword xml:lang="es">programación</keyword>
  </keywords>

